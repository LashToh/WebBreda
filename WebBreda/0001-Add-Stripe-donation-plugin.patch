+			</td>
+		</tr>
+		<tr>
+			<th><b>[ Currency ]</b><br/><span>3-letter ISO currency code used for all packs (e.g. usd, eur).</span></th>
+			<td>
+				<input style="width: 100%;" class="input-xxlarge" type="text" name="setting_8" value="<?php echo mconfig('currency', true); ?>"/>
