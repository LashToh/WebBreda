# Copy to .env and adjust as needed:  cp .env.example .env

# --- WebEngine -------------------------------------------------------------
WEBENGINE_VERSION=1.2.7
WEBSITE_TEMPLATE="Mu Breda"
WEBSITE_TITLE="MU Breda Season 6"
SERVER_NAME=MuBreda
# Website admin: a game account from the DB (default backup ships mspro/mspro).
WEBENGINE_ADMIN_USER=mspro

# --- Database (MSSQL) ------------------------------------------------------
DB_NAME=MuOnline
DB_USER=sa
# SA password must meet SQL Server complexity rules (upper, lower, digit/symbol).
DB_PASS=Dev_Str0ng!Pass

# --- Host port mappings ----------------------------------------------------
WEB_PORT=8080
DB_PORT_HOST=1433
NGROK_WEB_PORT=4040

# --- ngrok (payment webhook testing) --------------------------------------
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Container resource limits --------------------------------------------
# Hard caps so Docker can't consume the whole machine. Tune to your hardware.
# SQL Server needs a >=2 GB container; DB_MSSQL_MEMORY_MB caps SQL Server itself.
DB_CPUS=2
DB_MEMORY=3g
DB_MSSQL_MEMORY_MB=2048
WEB_CPUS=1.5
WEB_MEMORY=768m
NGROK_CPUS=0.5
NGROK_MEMORY=128m
